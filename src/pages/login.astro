---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/LoginForm";
import Logo from "../components/Logo";
---

<Layout>
  <div class="min-h-dvh lg:min-h-screen grid lg:grid-cols-2">
    <div class="hidden lg:flex flex-col items-center justify-center relative overflow-hidden bg-gradient-to-b from-amber-500/[0.03] to-transparent border-r border-border-sidebar">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(245,158,11,0.06),transparent_70%)]" />
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-amber-500/3 blur-[100px]" />
      <div class="absolute animate-rotate-slow opacity-[0.08]">
        <svg width="400" height="400" viewBox="0 0 200 200" fill="none">
          <polygon points="100,10 172.5,55 172.5,145 100,190 27.5,145 27.5,55" stroke="#f59e0b" strokeWidth="0.5" />
          <polygon points="100,30 157.5,65 157.5,135 100,170 42.5,135 42.5,65" stroke="#f59e0b" strokeWidth="0.3" opacity="0.5" />
          <polygon points="100,50 142.5,75 142.5,125 100,150 57.5,125 57.5,75" stroke="#f59e0b" strokeWidth="0.2" opacity="0.3" />
        </svg>
      </div>
      <div class="relative z-10 text-center px-12">
        <a href="/" class="inline-flex items-center gap-3 mb-8 group">
          <Logo class="w-10 h-10" />
          <span class="font-heading text-2xl tracking-[0.15em] text-amber-heading">AETHERIX</span>
        </a>
        <h2 class="font-heading text-5xl font-bold text-amber-heading mb-4 leading-tight">WELCOME<br />BACK</h2>
        <p class="text-text-label font-body text-base leading-relaxed max-w-sm mx-auto">
          Continue your journey with Aetherix. Master new skills and push your limits.
        </p>
        <div class="flex items-center justify-center gap-2 mt-10">
          <span class="w-16 h-[1px] bg-gradient-to-r from-transparent to-amber-500/30" />
          <span class="w-2 h-2 rounded-full bg-amber-500/40" />
          <span class="w-16 h-[1px] bg-gradient-to-l from-transparent to-amber-500/30" />
        </div>
      </div>
    </div>

    <div class="flex items-center justify-center p-3 sm:p-4 md:p-6 lg:p-8">
      <div class="w-full max-w-sm sm:max-w-md lg:max-w-[420px]">
        <LoginForm client:load />
      </div>
    </div>
  </div>
</Layout>
